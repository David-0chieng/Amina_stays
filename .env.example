# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=                 # optional registered sender ID / shortcode
AT_PAYMENT_PRODUCT=AminaStays # payment product name from the AT dashboard
AT_VOICE_NUMBER=              # e.g. +254711082XXX — Voice has NO sandbox, needs live credentials
PAYMENT_MODE=live             # live | simulate (simulate auto-confirms payments, for demos)

# Shown on the website so guests can find the other channels
USSD_CODE=                    # e.g. *384*1234#
AT_SMS_NUMBER=                # Ask Amina number/shortcode

# Amina
AMINA_PHONE=+2547XXXXXXXX
HOST_PIN=                     # PIN for /host.html

# Voice callbacks (your public URL, e.g. ngrok) — callback URLs: /voice, /sms/incoming, /ussd, /payments/callback
PUBLIC_URL=
PORT=3000
DEMO=0                        # 1 enables /demo/* routes (they bypass payment — never in production)

# Card payments for foreign guests: simulate (hosted test page) — add a real provider in payments.js CARD_PROVIDERS
CARD_PROVIDER=simulate

# Guest experience
CHECKOUT_HOUR=11              # Kenya time; stays not checked out by then are auto-completed and the code disabled
REVIEW_DELAY_MIN=60           # minutes after checkout before the "Reply 1-5" review SMS
TAXI_CONTACT=                 # Amina's trusted driver, included in the check-in tips SMS
GOODWILL_AIRTIME_KES=0        # airtime sent to Kenyan guests when Amina cancels a paid booking (0 = off)
