# Amina Stays — copy to .env (repo root or backend/.env) and fill in what you need.
# Everything is optional for a local demo: with no keys set, SMS/voice run in dry-run mode,
# payments are simulated and the Demo Lab (/demo) lets you drive USSD, SMS and voice in the browser.

# ---------- Django ----------
DEBUG=1                                   # 0 in production
SECRET_KEY=                               # required when DEBUG=0: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEMO=1                                    # Demo Lab, on-screen login codes, demo shortcuts. Set 0 in production!
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.ngrok-free.app,.ngrok.app,.trycloudflare.com
DATABASE_URL=postgres://amina:amina@localhost:5432/amina
LOG_LEVEL=INFO
# SECURE_COOKIES=1                        # secure cookies when DEBUG=0 (default on)
# SECURE_HSTS_SECONDS=0
# CSRF_TRUSTED_ORIGINS=                   # extra origins, comma separated
# CORS_ALLOWED_ORIGINS=

# ---------- URLs ----------
FRONTEND_URL=http://localhost:3000        # where guests open links (trip pages, card checkout)
BACKEND_URL=http://127.0.0.1:8000         # Next.js proxies /api, /at, /admin, /media here
PUBLIC_URL=                               # public HTTPS base Africa's Talking calls back on, e.g. https://abc123.ngrok-free.app
                                          # for live M-Pesa (DARAJA_ENV=production) it must be your own https domain - Safaricom blocks ngrok

# ---------- The host ----------
AMINA_PHONE=+254700000001                 # Amina's phone: alerts, approvals, digests, "#12 reply" commands (a demo number: set hers)
ID_ENCRYPTION_KEY=                        # Fernet key for guest ID numbers (derived from SECRET_KEY if empty)

# ---------- Africa's Talking ----------
AT_USERNAME=sandbox                       # "sandbox" for the simulator, your app username for live
AT_API_KEY=                               # empty = dry run (messages are logged, not sent)
AT_SENDER_ID=                             # approved alphanumeric sender ID (apply in the AT dashboard); empty = send from AT_SMS_NUMBER
                                          # with neither, AT's default sender only reaches Airtel numbers in Kenya - login codes won't arrive
AT_SMS_NUMBER=                            # two-way shortcode for "Ask Amina" (incoming SMS callback), shown to guests, e.g. 20880
AT_USSD_CODE=                             # shown to guests, e.g. *384*12345#
AT_VOICE_NUMBER=                          # your AT voice number in +E.164, e.g. +254711082000 (Voice has no sandbox)
AT_WHATSAPP_NUMBER=                       # optional WhatsApp channel (preview product)
AT_WEBHOOK_SECRET=                        # recommended: callbacks then live at /at/<secret>/… (AT doesn't sign webhooks)
AT_DATA_PRODUCT=                          # Mobile Data product name: outage and reward bundles, the optional welcome bundle (live keys without it = no data bundles)
AT_PAYMENT_PRODUCT=AminaStays             # only for MPESA_PROVIDER=africastalking (onboarding-gated)
AT_HTTP_TIMEOUT=10
# GUIDE_REGION=Kenya                      # added to local-guide map searches, e.g. "Fort Jesus, Old Town, Kenya" (default: Kenya)
SIM_SWAP_PROVIDER=                        # africastalking | simulate | empty = auto (simulate without an API key; numbers ending 999 = swapped)

# ---------- Payments ----------
# Cards go through Stripe Checkout (Stripe's hosted page): set the secret key and card payments are real.
STRIPE_SECRET_KEY=                        # sk_test_... (test cards) or sk_live_..., from Stripe > Developers > API keys; empty = a simulated card page
STRIPE_WEBHOOK_SECRET=                    # whsec_... of a webhook to https://<your-site>/api/payments/stripe/webhook for the checkout.session.* events
                                          # optional: without it a card payment confirms when the guest returns to the site, or within 2 minutes
CARD_PROVIDER=                            # empty = stripe once STRIPE_SECRET_KEY is set (else simulate) | paystack
PAYSTACK_SECRET_KEY=                      # only for CARD_PROVIDER=paystack

# M-Pesa is off until Safaricom's Daraja Go-Live is done: guests pay by card on every channel (USSD/SMS/voice get a link by SMS).
MPESA_PROVIDER=off                        # off | simulate (a pretend prompt, for demos) | daraja | africastalking
SIM_PAY_DELAY_SECONDS=6                   # simulated STK push succeeds after N seconds (0 = only via the Demo Lab button)
DARAJA_ENV=sandbox                        # sandbox | production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379                   # 174379 is the sandbox; live = your Paybill (for a Till, the store/HO number)
DARAJA_PASSKEY=                           # the live passkey comes by email after Go-Live
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline  # CustomerPayBillOnline (Paybill) | CustomerBuyGoodsOnline (Till)
DARAJA_PARTY_B=                           # the Till number for CustomerBuyGoodsOnline (empty = DARAJA_SHORTCODE)
DARAJA_CALLBACK_SECRET=                   # path secret shared by the M-Pesa prompt (STK) and Paybill (C2B) callbacks; empty = AT_WEBHOOK_SECRET
                                          # use hex (python -c "import secrets; print(secrets.token_hex(24))"): Safaricom rejects URLs with words like exe, cmd, sql, query
MPESA_SHORTCODE=                          # Paybill shown to guests as the fallback when the STK prompt fails (defaults to DARAJA_SHORTCODE when that's a Paybill; 174379 in DEMO)
                                          # Paybill only: a Till payment carries no account number, so it can't be matched to a booking
                                          # register the Paybill callbacks once with: cd backend && uv run python manage.py register_c2b
                                          # (live URLs must be https on your own domain: Safaricom blocks ngrok and similar tunnels)

# ---------- Smart locks ----------
IGLOOHOME_API_BASE=                       # empty = simulated keypad codes
IGLOOHOME_API_KEY=

# ---------- Background jobs ----------
SCHEDULER_INTERVAL_SECONDS=30             # python manage.py run_scheduler
OUTBOX_MODE=thread                        # thread | sync | queue (queue = the scheduler sends)
DB_CONN_MAX_AGE=60
